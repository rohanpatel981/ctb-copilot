# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Storage ---
# Where uploaded Excel files are kept. Local disk for v1.
STORAGE_DIR=./data/uploads

# --- Database ---
# DuckDB file path. Created on first run.
DUCKDB_PATH=./data/ctb.duckdb

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- UI ---
# How Streamlit reaches the API.
API_BASE_URL=http://127.0.0.1:8000

# --- Auth (optional, but REQUIRED for any multi-tenant deployment) ---
# Bearer token the FE must present on every API call that touches tenant
# data (/sync, /query, /upload, /uploads, /periods, /entities).
#
# If unset, the API runs in dev mode with no auth — fine for single-user
# local work, NEVER for production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#API_TOKEN=...

# --- DocumentDB sync (optional) ---
# Configure when you want to sync trial balances directly from an existing
# AWS DocumentDB (or Mongo-compatible) collection instead of uploading Excel.
# Leave blank to disable; the Excel upload path keeps working regardless.
#
# DOCDB_URI: standard Mongo connection string. For DocumentDB include
#   tls=true and the bundled CA file path; replicaSet=rs0 is typical.
#DOCDB_URI=mongodb://user:pass@docdb-xxx.cluster-yyy.<region>.docdb.amazonaws.com:27017/?tls=true&replicaSet=rs0&retryWrites=false
#DOCDB_DATABASE=accounting
#DOCDB_COLLECTION=consolidated_tb
#
# Static filter that applies to every sync (the parts that don't change
# between periods). JSON object — passed verbatim to pymongo `find()`.
#DOCDB_DEFAULT_FILTER={"client_id":"abc-123","gaap_id":"ind_as","currency_id":"INR","status":"ACTIVE"}
#
# Which field in YOUR documents represents the FY. The sync endpoint will
# inject {DOCDB_PERIOD_FIELD: <selected_period>} into the filter at sync time.
#DOCDB_PERIOD_FIELD=fin_year_id
#
# (Optional) Additional fixed field — e.g. always sync the Annual reporting
# period vs Q1/Q2. Merged into the filter at sync time.
#DOCDB_REPORTING_PERIOD=Annual
#DOCDB_REPORTING_PERIOD_FIELD=reporting_period_id
